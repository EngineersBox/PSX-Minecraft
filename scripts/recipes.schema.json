{
    "$id": "/assets/recipes",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "pattern": {
                "type": "array",
                "items": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "item": {
                                "type": "string",
                                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                            },
                            "metadata": {
                                "type": "integer",
                                "default": 0,
                                "minimum": 0,
                                "maximum": 255
                            },
                            "stack_size": {
                                "type": "integer",
                                "default": 1,
                                "minimum": 1,
                                "maximum": 255
                            },
                            "ignore_metadata": {
                                "type": "boolean",
                                "default": false
                            }
                        },
                        "required": [
                            "item"
                        ],
                        "additionalProperties": false
                    },
                    "minItems": 1
                },
                "minItems": 1
            },
            "output": {
                "type": "object",
                "properties": {
                    "results": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "item": {
                                    "type": "string",
                                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                                },
                                "metadata": {
                                    "type": "integer",
                                    "default": 0,
                                    "minimum": 0,
                                    "maximum": 255
                                },
                                "stack_size": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 255
                                }
                            },
                            "required": [
                                "item",
                                "stack_size"
                            ],
                            "additionalProperties": false
                        },
                        "minItems": 1
                    },
                    "processing_ticks": {
                        "type": "integer",
                        "default": 1,
                        "minimum": 1,
                        "maximum": 65536
                    }
                },
                "required": [
                    "results"
                ],
                "additionalProperties": false
            }
        },
        "required": [
            "pattern",
            "output"
        ],
        "additionalProperties": false
    },
    "minItems": 1
}
